# Domain, unter der App und API erreichbar sind (DNS muss auf den Server zeigen)
DOMAIN=www.wurst-weiser.de
# Leiten per 301 auf DOMAIN um (kommagetrennt, jeweils mit DNS-Eintrag auf den Server); mindestens ein Name
REDIRECT_DOMAINS=wurst-weiser.de
# Lange Zufallswerte, z. B.: openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
# Image-Versionen aus ghcr.io: main = neuester Stand, für ein Rollback z. B. sha-1a2b3c4
API_TAG=main
APP_TAG=main
# Nur für docker-compose.build.yml: Pfad zum ausgecheckten sausage-app-Repo (relativ zu diesem Ordner)
APP_SOURCE=../../sausage-app
# Wie viele Tage Backups aufbewahrt werden
BACKUP_KEEP_DAYS=14
# E-Mail-Versand per SMTP (z. B. Postmark, Brevo, Mailjet oder das Postfach des Hosters).
# Leer lassen = Mails werden nur ins Log geschrieben (Passwort-Links dann nicht zustellbar!)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Wurst-Weiser <noreply@wurst-weiser.de>
