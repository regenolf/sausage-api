# HTTPS mit automatischem Let's-Encrypt-Zertifikat für $DOMAIN (Port 80/443 müssen erreichbar sein).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:80
}

# Weitere Namen (z. B. die Domain ohne www) leiten dauerhaft auf $DOMAIN um, ebenfalls mit Zertifikat.
{$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} permanent
}
